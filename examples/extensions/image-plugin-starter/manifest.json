{
  "apiVersion": 1,
  "id": "org.example.image-gain",
  "name": "Image Gain",
  "version": "1.0.0",
  "author": "Example author",
  "description": "A standalone image processor with native and sandboxed backends. Preview before applying.",
  "permissions": {"documentRead": true, "commands": ["plugin.processImage"]},
  "capabilities": {"required": [{"id": "host.commands.invoke", "minVersion": 1}], "optional": []},
  "panel": {
    "preview": true,
    "fields": [
      {"id": "gain", "label": "Gain", "type": "number", "min": 0, "max": 2, "default": 1.25},
      {"id": "backend", "label": "Processing", "type": "choice", "options": ["Native worker", "Sandboxed filter"], "default": "Native worker"}
    ],
    "buttons": [{"id": "process", "label": "Generate preview"}]
  }
}
