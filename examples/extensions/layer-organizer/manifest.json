{
  "apiVersion": 1,
  "id": "org.example.layer-organizer",
  "name": "Layer Organizer",
  "version": "1.0.0",
  "author": "PhotoCraft contributors",
  "description": "Number and name layers in a single Undo step. All edits are validated before any layer changes.",
  "permissions": {"documentRead": false, "commands": []},
  "capabilities": {"required": [{"id": "host.document.read", "minVersion": 1}, {"id": "host.document.edit", "minVersion": 1}], "optional": []},
  "contributes": {"commands": [{"id": "org.example.layer-organizer.organize", "label": "Organize layer names", "event": "organize", "params": {}, "needsDocument": true}]},
  "panel": {
    "fields": [
      {"id": "prefix", "label": "Name prefix", "type": "choice", "options": ["Organized", "Review", "Export"], "default": "Organized"},
      {"id": "selectedOnly", "label": "Selected layers only", "type": "bool", "default": false}
    ],
    "buttons": [{"id": "organize", "label": "Organize layer names"}]
  }
}
