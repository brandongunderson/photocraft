[
  {
    "id": "org.example.image-gain",
    "manifest": {
      "apiVersion": 1,
      "author": "Example author",
      "description": "A standalone image processor with native and sandboxed backends. Preview before applying.",
      "id": "org.example.image-gain",
      "name": "Image Gain",
      "panel": {
        "buttons": [
          {
            "id": "process",
            "label": "Generate preview"
          }
        ],
        "fields": [
          {
            "default": 1.25,
            "id": "gain",
            "label": "Gain",
            "max": 2.0,
            "min": 0.0,
            "type": "number"
          },
          {
            "default": "Native worker",
            "id": "backend",
            "label": "Processing",
            "options": [
              "Native worker",
              "Sandboxed filter"
            ],
            "type": "choice"
          }
        ],
        "preview": true
      },
      "permissions": {
        "commands": [
          "plugin.processImage"
        ],
        "documentRead": true
      },
      "version": "1.0.0"
    },
    "module": "frozen/image-gain-panel-v1.wasm",
    "request": {
      "document": {
        "activeLayer": 1,
        "depth": 16,
        "height": 6,
        "id": 1,
        "mode": "Rgb",
        "name": "Compatibility fixture",
        "revision": 0,
        "width": 8
      },
      "event": "process",
      "state": {
        "oldState": 7
      },
      "values": {
        "backend": "Sandboxed filter",
        "gain": 0.5
      }
    },
    "response": {
      "commands": [
        {
          "command": "plugin.processImage",
          "params": {
            "options": {
              "gain": 0.5
            },
            "preview": true,
            "processor": "org.example.channel-gain"
          }
        }
      ],
      "message": "Processing image. Compare the preview, then choose Apply or Discard.",
      "state": {
        "oldState": 7
      }
    }
  }
]
