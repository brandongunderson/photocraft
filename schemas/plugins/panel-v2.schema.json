{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Descriptor",
  "description": "Complete independent descriptor for the current PhotoCraft Plugin API.",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "integer",
      "format": "uint32",
      "maximum": 2,
      "minimum": 2
    },
    "author": {
      "type": "string",
      "default": "",
      "maxLength": 128
    },
    "capabilities": {
      "$ref": "#/$defs/Capabilities"
    },
    "contributes": {
      "$ref": "#/$defs/Contributions"
    },
    "description": {
      "type": "string",
      "default": "",
      "maxLength": 1024
    },
    "id": {
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "name": {
      "type": "string",
      "maxLength": 64,
      "minLength": 1
    },
    "panel": {
      "$ref": "#/$defs/Panel"
    },
    "permissions": {
      "$ref": "#/$defs/Permissions"
    },
    "repository": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 160
    },
    "updates": {
      "anyOf": [
        {
          "$ref": "#/$defs/UpdateSource"
        },
        {
          "type": "null"
        }
      ]
    },
    "version": {
      "type": "string",
      "maxLength": 32
    }
  },
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "id",
    "name",
    "version",
    "permissions",
    "panel"
  ],
  "$defs": {
    "Button": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_]*$"
        },
        "label": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "label"
      ]
    },
    "Capabilities": {
      "type": "object",
      "properties": {
        "optional": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/CapabilityRequirement"
          },
          "maxItems": 32
        },
        "required": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/CapabilityRequirement"
          },
          "maxItems": 32
        }
      },
      "additionalProperties": false
    },
    "CapabilityId": {
      "description": "Extensible capability identifier. Unknown optional IDs survive parsing and negotiate absent.",
      "type": "string",
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "CapabilityRequirement": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/CapabilityId"
        },
        "maxVersion": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "maximum": 1024,
          "minimum": 1
        },
        "minVersion": {
          "type": "integer",
          "format": "uint16",
          "maximum": 1024,
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "minVersion"
      ]
    },
    "CommandContribution": {
      "type": "object",
      "properties": {
        "event": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_]*$"
        },
        "id": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        },
        "label": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        },
        "needsDocument": {
          "type": "boolean",
          "default": false
        },
        "params": {
          "type": "object",
          "additionalProperties": true,
          "default": {}
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "event"
      ]
    },
    "Contributions": {
      "type": "object",
      "properties": {
        "commands": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/CommandContribution"
          },
          "maxItems": 32
        },
        "inspectors": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/InspectorContribution"
          },
          "maxItems": 8
        },
        "subscriptions": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/EventSubscription"
          },
          "maxItems": 16
        }
      },
      "additionalProperties": false
    },
    "EventKind": {
      "type": "string",
      "enum": [
        "document.changed"
      ]
    },
    "EventSubscription": {
      "type": "object",
      "properties": {
        "event": {
          "$ref": "#/$defs/EventKind"
        },
        "handler": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_]*$"
        },
        "id": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "event",
        "handler"
      ]
    },
    "Field": {
      "description": "Declarative controls with no dependency on the host UI implementation.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_]*$"
        },
        "label": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "default": {
              "type": "number",
              "format": "double"
            },
            "max": {
              "type": "number",
              "format": "double"
            },
            "min": {
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "number"
            }
          },
          "required": [
            "type",
            "min",
            "max",
            "default"
          ]
        },
        {
          "type": "object",
          "properties": {
            "default": {
              "type": "integer",
              "format": "int64",
              "default": 0
            },
            "max": {
              "type": "integer",
              "format": "int64",
              "default": 1000000
            },
            "min": {
              "type": "integer",
              "format": "int64",
              "default": -1000000
            },
            "type": {
              "type": "string",
              "const": "int"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "default": {
              "type": "boolean",
              "default": false
            },
            "type": {
              "type": "string",
              "const": "bool"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "default": {
              "type": [
                "string",
                "null"
              ],
              "default": null
            },
            "options": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 64,
              "minItems": 1
            },
            "type": {
              "type": "string",
              "const": "choice"
            }
          },
          "required": [
            "type",
            "options"
          ]
        }
      ],
      "required": [
        "id",
        "label"
      ],
      "unevaluatedProperties": false
    },
    "InspectorContribution": {
      "type": "object",
      "properties": {
        "event": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_]*$"
        },
        "id": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        },
        "label": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "event"
      ]
    },
    "Panel": {
      "type": "object",
      "properties": {
        "buttons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Button"
          },
          "maxItems": 16
        },
        "fields": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Field"
          },
          "maxItems": 32
        },
        "preview": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "buttons"
      ]
    },
    "Permissions": {
      "type": "object",
      "properties": {
        "commands": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 128
        },
        "documentRead": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "UpdateProvider": {
      "type": "string",
      "enum": [
        "github"
      ]
    },
    "UpdateSource": {
      "description": "A plugin-owned release source. Declaring it never starts a network request or installs code.",
      "type": "object",
      "properties": {
        "asset": {
          "description": "Exact release filename, optionally containing one `{platform}` substitution.",
          "type": "string",
          "maxLength": 160,
          "minLength": 1
        },
        "provider": {
          "$ref": "#/$defs/UpdateProvider"
        }
      },
      "additionalProperties": false,
      "required": [
        "provider",
        "asset"
      ]
    }
  }
}