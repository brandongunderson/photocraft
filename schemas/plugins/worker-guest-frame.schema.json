{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkerHostFrame",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "generation": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WorkerOperation"
          }
        },
        "pluginId": {
          "type": "string"
        },
        "protocolVersion": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "type": {
          "type": "string",
          "const": "ready"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "protocolVersion",
        "pluginId",
        "generation",
        "operations"
      ]
    },
    {
      "type": "object",
      "properties": {
        "fraction": {
          "type": "number",
          "format": "double"
        },
        "id": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "progress"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "fraction",
        "message"
      ]
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "result"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ]
    },
    {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/$defs/ApiError"
        },
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "error"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "error"
      ]
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "cancelled"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ]
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "resetComplete"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ]
    }
  ],
  "$defs": {
    "ApiError": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "details": {
          "default": null
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ]
    },
    "ErrorCode": {
      "description": "Stable machine-readable failures. Callers should match codes, not prose.",
      "type": "string",
      "enum": [
        "invalidJson",
        "invalidDescriptor",
        "limitExceeded",
        "incompatibleApi",
        "missingCapability",
        "unsupportedVersion",
        "permissionDenied",
        "invalidHandle",
        "staleRevision",
        "notFound",
        "conflict",
        "unsupportedOperation"
      ]
    },
    "WorkerOperation": {
      "type": "string",
      "enum": [
        "image",
        "task"
      ]
    }
  }
}